}

// =============================================
// 17. COTIZACIONES (presupuestos previos a orden)
// =============================================
model Quotation {
  id                 String    @id @default(uuid()) @db.Uuid
  workspace_id       String?   @db.Uuid
  quotation_number   String    // Ej: COT-26-0001 — autoincrementable por workspace
  client_id          String    @db.Uuid
  motorcycle_id      String?   @db.Uuid
  customer_complaint String?   // Falla / motivo
  notes              String?
  labor_total        Decimal   @default(0) @db.Decimal(10, 2)
  parts_total        Decimal   @default(0) @db.Decimal(10, 2)
  total_amount       Decimal   @default(0) @db.Decimal(10, 2)
  status             String    @default("pendiente") // pendiente | aceptada | rechazada | expirada | convertida
  valid_until        DateTime? @db.Timestamptz
  converted_order_id String?   @unique @db.Uuid // si se convirtió en orden
  created_by         String?   @db.Uuid // mechanic id
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt

  workspace  Workspace?       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  client     Client           @relation(fields: [client_id], references: [id])
  motorcycle Motorcycle?      @relation(fields: [motorcycle_id], references: [id])
  parts      QuotationPart[]
  labor      QuotationLabor[]

  @@index([workspace_id])
  @@index([client_id])
  @@index([status])
  @@map("quotations")
}

model QuotationLabor {
  id           String   @id @default(uuid()) @db.Uuid
  workspace_id String?  @db.Uuid
  quotation_id String   @db.Uuid
  name         String
  price        Decimal  @db.Decimal(10, 2)
  created_at   DateTime @default(now()) @db.Timestamptz

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  quotation Quotation  @relation(fields: [quotation_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([quotation_id])
  @@map("quotation_labor")
}

model QuotationPart {
  id           String   @id @default(uuid()) @db.Uuid
  workspace_id String?  @db.Uuid
  quotation_id String   @db.Uuid
  name         String
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int      @default(1)
  notes        String?
  created_at   DateTime @default(now()) @db.Timestamptz

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  quotation Quotation  @relation(fields: [quotation_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([quotation_id])
  @@map("quotation_parts")
}

// =============================================
// 18. PAGOS / ABONOS POR ORDEN (ELIHU workflow v1)
// =============================================
// Pagos parciales del cliente sobre una orden. NUNCA se borran físicamente:
// un pago cancelado se marca con cancelled_at + motivo (auditoría). El saldo
// pendiente se calcula sumando los pagos no cancelados (ver lib/payments.js).
model OrderPayment {
  id                  String    @id @default(uuid()) @db.Uuid
  workspace_id        String?   @db.Uuid
  order_id            String    @db.Uuid
  receipt_number      String?   @unique           // folio legible del recibo (REC-26-0001)
  amount              Decimal   @db.Decimal(10, 2)
  payment_method      String    @default("efectivo") // efectivo | transferencia | tarjeta | otro
  payment_date        DateTime  @default(now()) @db.Timestamptz
  note                String?
  received_by         String?   @db.Uuid           // quién recibió el pago (Profile)
  created_by          String?   @db.Uuid
  cancelled_at        DateTime? @db.Timestamptz
  cancelled_by        String?   @db.Uuid
  cancellation_reason String?
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([order_id])
  @@map("order_payments")
}


// =============================================
// MÓDULO INTERNO — MOTOPARTES QUESTIONS
// =============================================
// Cuestionario privado para entender cómo usan el sistema los mecánicos
// maestros ELIHU y MACIEL. Es un módulo AISLADO:
//   - Las tablas NO tienen workspace_id.
//   - NO se añaden al Set SCOPED_MODELS en src/lib/prisma.js, por lo que el
//     auto-scoping de workspace NUNCA las toca.
//   - Las rutas (/api/questions) NO usan resolveWorkspace, así que no
//     interfieren con el aislamiento multi-tenant existente.
// La definición del cuestionario (secciones/preguntas) vive como JSON estático
// versionado en src/lib/questions-survey.js; aquí solo persistimos respuestas.

model SurveyParticipant {
  id           String    @id @default(uuid()) @db.Uuid
  key          String    @unique                  // ELIHU | MACIEL
  display_name String
  status       String    @default("NOT_STARTED")  // NOT_STARTED | IN_PROGRESS | SUBMITTED
  locked       Boolean   @default(false)          // true tras enviar; el admin puede desbloquear para corregir
  submitted_at DateTime? @db.Timestamptz
  survey_version String?                          // versión del cuestionario respondido (trazabilidad)
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz

  answers SurveyAnswer[]

  @@map("survey_participants")
}

model SurveyAnswer {
  id             String   @id @default(uuid()) @db.Uuid
  participant_id String   @db.Uuid
  question_key   String
  answer_value   Json?                            // estructura según el tipo de pregunta
  answer_text    String?                          // texto "Otro, explicar" o respuestas libres
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz

  participant SurveyParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)

  @@unique([participant_id, question_key])
  @@index([participant_id])
  @@map("survey_answers")
}

model SurveyEvent {
  id              String   @id @default(uuid()) @db.Uuid
  actor           String                           // admin | ELIHU | MACIEL
  action          String                           // login | save | submit | unlock | export
  participant_key String?
  detail          Json     @default("{}")
  ip_address      String?
  created_at      DateTime @default(now()) @db.Timestamptz

  @@index([created_at])
  @@map("survey_events")
}

// ─── Impresión de tickets ────────────────────────────────────────────────
// La laptop del taller corre un agente que consulta la cola cada ~3 s con una
// clave propia (solo se guarda su hash). Contrato: docs/IMPRESION-CONTRATO.md.
model PrintAgent {
  id            String    @id @default(uuid()) @db.Uuid
  workspace_id  String    @db.Uuid
  name          String    @default("Laptop del taller")
  key_hash      String    @unique              // sha256 (hex) de la clave mpp_…
  key_prefix    String                         // primeros caracteres, solo para mostrar
  last_seen_at  DateTime? @db.Timestamptz
  agent_version String?
  printer_name  String?
  revoked_at    DateTime? @db.Timestamptz
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz

  workspace Workspace  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  jobs      PrintJob[]

  @@index([workspace_id])
  @@map("print_agents")
}

model PrintJob {
  id              String    @id @default(uuid()) @db.Uuid
  workspace_id    String    @db.Uuid
  order_id        String?   @db.Uuid
  kind            String    @default("ticket")    // ticket | test
  status          String    @default("pending")   // pending | printing | printed | failed | cancelled
  copies          Int       @default(1)
  attempts        Int       @default(0)
  error           String?
  title           String?
  payload_b64     String    @db.Text              // bytes ESC/POS en base64
  next_attempt_at DateTime? @db.Timestamptz       // no reclamar antes de esta hora (reintentos)
  claimed_at      DateTime? @db.Timestamptz
  printed_at      DateTime? @db.Timestamptz
  agent_id        String?   @db.Uuid
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz

  workspace Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  agent     PrintAgent? @relation(fields: [agent_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, status])
  @@index([order_id])
  @@map("print_jobs")
}


// =============================================
// WHATSAPP V2 — bandeja de conversaciones y cola de envíos
// =============================================
model WaConversation {
  id                   String    @id @default(uuid()) @db.Uuid
  workspace_id         String    @db.Uuid
  phone                String                          // 10 dígitos (MX) o dígitos completos si es otro país / id no resuelto
  wa_chat_id           String?                         // 5219611234567@c.us | ...@lid
  display_name         String?
  client_id            String?   @db.Uuid
  last_message_preview String?
  last_message_at      DateTime? @db.Timestamptz
  last_direction       String?                         // in | out
  unread_count         Int       @default(0)
  hidden               Boolean   @default(false)
  // Maestro (Profile.id) a cargo del chat: se deduce de sus órdenes/citas/mensajes o se asigna a mano (assigned_manually).
  assigned_to          String?   @db.Uuid
  assigned_manually    Boolean   @default(false)
  // Foto de perfil de WhatsApp del contacto (copia en WaMedia). avatar_checked_at = última vez que se pidió al bot.
  avatar_media_id      String?   @db.Uuid
  avatar_checked_at    DateTime? @db.Timestamptz
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz

  workspace Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  messages  WaMessage[]

  @@unique([workspace_id, phone])
  @@index([workspace_id, last_message_at])
  @@index([workspace_id, assigned_to])
  @@map("wa_conversations")
}

model WaMessage {
  id              String   @id @default(uuid()) @db.Uuid
  workspace_id    String   @db.Uuid
  conversation_id String   @db.Uuid
  wa_message_id   String?                              // id de WhatsApp (dedupe)
  direction       String                               // in | out
  origin          String                               // client | phone | panel | auto
  body            String   @default("")
  media_id        String?  @db.Uuid
  // Tipo de archivo del mensaje (image | sticker | audio | ptt | video | document). El archivo se baja la 1a vez que alguien lo abre.
  media_type      String?
  media_mime      String?
  media_name      String?                              // nombre del documento
  media_seconds   Int?                                 // duración de audios/videos
  status          String   @default("sent")            // queued | sent | delivered | read | failed
  sent_by         String?  @db.Uuid                    // Profile que escribió desde el panel
  error           String?
  // Eliminar para todos (revocado en WhatsApp): el contenido se borra y queda la marca. revoked_by null = lo borró el contacto o el teléfono.
  revoked_at      DateTime? @db.Timestamptz
  revoked_by      String?  @db.Uuid
  // "Eliminar para mí": Profile.id de quienes ya no ven este mensaje en el panel
  hidden_for      String[] @db.Uuid @default([])
  created_at      DateTime @default(now()) @db.Timestamptz

  workspace    Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  conversation WaConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, wa_message_id])
  @@index([conversation_id, created_at])
  @@map("wa_messages")
}

model WaMedia {
  id           String   @id @default(uuid()) @db.Uuid
  workspace_id String   @db.Uuid
  mime         String
  size         Int      @default(0)
  data         Bytes
  created_at   DateTime @default(now()) @db.Timestamptz

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@map("wa_media")
}

// Cola de envíos del servidor: si el bot no está listo, el mensaje espera y se reintenta.
model WaOutbox {
  id              String    @id @default(uuid()) @db.Uuid
  workspace_id    String    @db.Uuid
  phone           String
  body            String
  kind            String    @default("text")           // text | auto | panel
  status          String    @default("pending")        // pending | sent | failed
  attempts        Int       @default(0)
  next_attempt_at DateTime  @default(now()) @db.Timestamptz
  last_error      String?
  context         Json      @default("{}")             // { order_id, appointment_id, message_id, sent_by, ... }
  created_at      DateTime  @default(now()) @db.Timestamptz
  sent_at         DateTime? @db.Timestamptz

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([status, next_attempt_at])
  @@index([workspace_id, created_at])
  @@map("wa_outbox")
}
