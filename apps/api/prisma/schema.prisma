  cost         Decimal  @default(0) @db.Decimal(10, 2)
  quantity     Int      @default(1)
  notes        String?
  created_at   DateTime @default(now()) @db.Timestamptz

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  service   Service?   @relation(fields: [service_id], references: [id])

  @@index([workspace_id])
  @@map("order_services")
}

// =============================================
// 8. REFACCIONES POR ORDEN
// =============================================
model OrderPart {
  id           String   @id @default(uuid()) @db.Uuid
  workspace_id String?  @db.Uuid
  order_id     String   @db.Uuid
  name         String
  part_number  String?
  cost         Decimal  @db.Decimal(10, 2)
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int      @default(1)
  notes        String?
  created_at   DateTime @default(now()) @db.Timestamptz

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@map("order_parts")
}

// =============================================
// 9. FOTOS DE ÓRDENES
// =============================================
model OrderPhoto {
  id           String   @id @default(uuid()) @db.Uuid
  workspace_id String?  @db.Uuid
  order_id     String   @db.Uuid
  url          String
  category     String?
  caption      String?
  uploaded_by  String?  @db.Uuid
  // ELIHU workflow v1: retención de evidencia 30 días. Nullable para fotos
  // antiguas. El sweep solo borra filas con expires_at < now() (ver lib/photo-retention).
  // `category` actúa como el "tipo" de foto (frente | trasera | tablero | daños | refacción | otra).
  expires_at   DateTime? @db.Timestamptz
  created_at   DateTime @default(now()) @db.Timestamptz

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  uploader  Profile?   @relation(fields: [uploaded_by], references: [id])

  @@index([workspace_id])
  @@map("order_photos")
}

// =============================================
// 10. HISTORIAL DE CAMBIOS
// =============================================
model OrderHistory {
  id           String   @id @default(uuid()) @db.Uuid
  workspace_id String?  @db.Uuid
  order_id     String   @db.Uuid
  changed_by   String?  @db.Uuid
  old_status   String?
  new_status   String
  notes        String?
  created_at   DateTime @default(now()) @db.Timestamptz

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  changer   Profile?   @relation(fields: [changed_by], references: [id])

  @@index([workspace_id])
  @@map("order_history")
}

// =============================================
// 11. ACTUALIZACIONES DE ORDEN
// =============================================
model OrderUpdate {
