server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Este archivo es una plantilla: la imagen nginx sustituye ${API_UPSTREAM} y
    # ${API_PORT} al arrancar (ver Dockerfile).

    # Docker DNS resolver
    resolver 127.0.0.11 valid=30s ipv6=off;

    # Todo /api/* va a la API, INCLUIDO /api/whatsapp-bot/*: la API ya es el
    # proxy hacia el bot (routes/whatsapp-bot-proxy.js quita el prefijo y agrega
    # la API key). NO agregar aqui un location propio para el bot: el rewrite a
    # /api/... daba 404 porque el bot sirve /sessions en la raiz (QR no cargaba).
    location /api/ {
        set $api_host ${API_UPSTREAM};

        # IMPORTANTE: con variables en proxy_pass NO se debe poner URI al final
        # (p.ej. ":3000/api/"): nginx reemplazaria TODA la URL por "/api/" y
        # rompe login y el resto de endpoints. Sin URI se envia la original.
        proxy_pass http://$api_host:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # SPA fallback (must be last)
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;
    gzip_min_length 1000;

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
